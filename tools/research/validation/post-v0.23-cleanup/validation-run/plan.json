{
  "version": 1,
  "inputs": [
    "/tmp/pandafish-cleanup-research",
    "tools/research/*.go",
    "testdata/*.json",
    "*.go",
    "go.mod",
    "go.sum",
    "internal/telemetry/*.go",
    "third_party/chess/*.go",
    "third_party/chess/go.mod",
    "third_party/chess/go.sum"
  ],
  "steps": [
    {
      "name": "normal-tests",
      "command": [
        "go",
        "test",
        "./..."
      ],
      "timeout_seconds": 180
    },
    {
      "name": "race-tests",
      "command": [
        "go",
        "test",
        "-race",
        "./..."
      ],
      "timeout_seconds": 300
    },
    {
      "name": "vet",
      "command": [
        "go",
        "vet",
        "./..."
      ],
      "timeout_seconds": 180
    },
    {
      "name": "chess-normal",
      "command": [
        "go",
        "-C",
        "third_party/chess",
        "test",
        "./..."
      ],
      "timeout_seconds": 180
    },
    {
      "name": "chess-race",
      "command": [
        "go",
        "-C",
        "third_party/chess",
        "test",
        "-race",
        "./..."
      ],
      "timeout_seconds": 300
    },
    {
      "name": "chess-vet",
      "command": [
        "go",
        "-C",
        "third_party/chess",
        "vet",
        "./..."
      ],
      "timeout_seconds": 180
    },
    {
      "name": "build-warm-test",
      "command": [
        "go",
        "test",
        "-c",
        "-o",
        "/tmp/pandafish-cleanup.test",
        "."
      ],
      "timeout_seconds": 180,
      "outputs": [
        "/tmp/pandafish-cleanup.test"
      ]
    },
    {
      "name": "build-engine",
      "command": [
        "go",
        "build",
        "-buildvcs=false",
        "-o",
        "/tmp/pandafish-cleanup-engine",
        "."
      ],
      "timeout_seconds": 180,
      "outputs": [
        "/tmp/pandafish-cleanup-engine"
      ]
    }
  ]
}
