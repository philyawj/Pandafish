{
  "version": 1,
  "inputs": [
    "/tmp/pandafish-cleanup-research",
    "tools/benchmark/bin/pandafish-v0.23",
    "/opt/homebrew/bin/stockfish",
    "tools/benchmark/research/v0.24-compact-search/FRESH_PLAN.md",
    "tools/benchmark/research/v0.24-compact-search/native-run/state.json",
    "tools/benchmark/research/v0.24-compact-search/warm_exclusions.go.txt",
    "/tmp/pandafish-v024-warm-exclusions.json",
    "/tmp/pandafish-v024-oracle-exclusions.json",
    "tools/benchmark/research/v0.17-search-moves/inputs.json",
    "tools/benchmark/research/v0.20-next-assessment/fresh-generation/inputs.json",
    "tools/benchmark/research/v0.2[23]-*/fresh-generation*/inputs.json",
    "tools/benchmark/live/*/analysis/stockfish-n100000/*.json",
    "tools/research/*.go",
    "third_party/chess/*.go"
  ],
  "steps": [
    {
      "name": "generate-frozen-controls",
      "command": [
        "/tmp/pandafish-cleanup-research", "generate",
        "--baseline", "tools/benchmark/bin/pandafish-v0.23",
        "--teacher", "/opt/homebrew/bin/stockfish",
        "--out", "tools/benchmark/research/v0.24-compact-search/fresh-generation",
        "--seed", "2026112201", "--stream", "124",
        "--exclude-input", "tools/benchmark/research/v0.17-search-moves/inputs.json",
        "--exclude-input", "tools/benchmark/research/v0.20-next-assessment/fresh-generation/inputs.json",
        "--exclude-input", "tools/benchmark/research/v0.2[23]-*/fresh-generation*/inputs.json",
        "--exclude-input", "/tmp/pandafish-v024-warm-exclusions.json",
        "--exclude-input", "/tmp/pandafish-v024-oracle-exclusions.json",
        "--exclude-analysis", "tools/benchmark/live/*/analysis/stockfish-n100000/*.json"
      ],
      "timeout_seconds": 600,
      "outputs": ["tools/benchmark/research/v0.24-compact-search/fresh-generation/*.json", "tools/benchmark/research/v0.24-compact-search/fresh-generation/*.jsonl"]
    }
  ]
}
